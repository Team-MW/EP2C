{
    "framework": "vite",
    "buildCommand": "npm run build",
    "outputDirectory": "dist",
    "functions": {
        "api/index.js": {
            "includeFiles": "node_modules/.prisma/client/**",
            "maxDuration": 30
        }
    },
    "rewrites": [
        { "source": "/api", "destination": "/api/index.js" },
        {
            "source": "/api/(.*)",
            "destination": "/api/index.js"
        },
        {
            "source": "/((?!api/.*).*)",
            "destination": "/index.html"
        }
    ]
}
