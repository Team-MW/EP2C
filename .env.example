# Backend only. Copy values into Vercel Environment Variables for each environment.
DATABASE_URL=mysql://USER:PASSWORD@HOST:3306/DATABASE?sslaccept=strict&connection_limit=1&connect_timeout=10&pool_timeout=10
CLERK_SECRET_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Public key embedded at build time. Must belong to the same Clerk instance.
VITE_CLERK_PUBLISHABLE_KEY=
